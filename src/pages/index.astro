---
import BaseLayout from '../layouts/BaseLayout.astro';
import { categories } from '../data/pieces.js';
---
<BaseLayout title="David King — Learning Design Specialist">
  <section class="hero" id="top">
    <div class="hero-media">
      <img src="/images/hero.png" alt="Dave collaborating with a colleague at a laptop in an office" />
    </div>
    <div class="wrap">
      <h1 class="headline">Learning Design Specialist</h1>
      <p class="hero-sub">Helping institutions build learning environments that cultivate genuine capability.</p>
      <hr class="hero-accent" />
      <div class="cta-row">
        <a href="#categories" class="btn primary">See the work</a>
        <a href="#contact" class="btn ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <section id="categories">
    <div class="wrap">
      <div class="section-head">
        <h2>Portfolio</h2>
        <p>Browse the selection of work samples that showcase my areas of expertise.</p>
      </div>
      <div class="cat-grid">
        {Object.values(categories).map((category) => (
          <a class="cat-card" href={`/${category.file}`}>
            <h3>{category.label}</h3>
            <p>{category.blurb}</p>
            <span class="count">Explore →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section id="background">
    <div class="wrap">
      <div class="section-head section-head--tight">
        <h2>About me</h2>
      </div>
      <div class="about-grid">
        <div class="about-photo">
          <img src="/images/profile-pic.jpeg" alt="David King" />
        </div>
        <div class="about-text" id="aboutText">
          <div class="about-body" id="aboutBody">
            <p>More than anything, learning requires effort. Unfortunately, effort is too often wasted. Reading without knowing why. Listening to an expert with no bridge between their knowledge and your own. Attempting something hard without the help needed to do it well.</p>
            <p>When I started in education, my mentor was an expert at creating experimental spaces where students could work right at the edge of their abilities: challenged but never lost, guided but never given the answer, supported to make discoveries through trial and error. In this environment, his students reached their own conclusions and built real skill through their own effort.</p>
            <p>Since moving into learning design, after many years writing curricula and designing courses in my own field, I've been building those same conditions into online learning environments. It's a gap I see often: a lot of online courses default to passive delivery, content to click through rather than problems to work through. And it's not just an online problem. Plenty of traditional classrooms, especially in higher education, lean the same way, treating a lecture or a reading list as if it were the learning itself.</p>
            <p>With technology and AI now part of mainstream education, the possibility of building authentic, engaging environments where learners can journey from novice to expert through simulated experience is greater than it's ever been. This portfolio demonstrates that thinking in action. It's a collection of work built over my career, each piece putting this philosophy into practice. Have a look through it. If something here resonates and you'd like to explore it for your own teaching or course design, get in touch.</p>
          </div>
          <button class="read-more-btn" id="readMoreBtn" type="button">Read more ↓</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const photo = document.querySelector('.about-photo');
      const textWrap = document.getElementById('aboutText');
      const body = document.getElementById('aboutBody');
      const btn = document.getElementById('readMoreBtn');
      if (!photo || !textWrap || !body || !btn) return;

      // The column height always tracks the photo's rendered height (not a
      // fixed value) so it stays correct across breakpoints and once a real
      // photo replaces the placeholder at a different aspect ratio. It's set
      // on the column itself (not just the clamped text) so the flex layout
      // pins the trigger to that exact bottom edge, flush with the photo.
      function syncClampHeight() {
        if (textWrap.classList.contains('expanded')) return;
        textWrap.style.height = photo.getBoundingClientRect().height + 'px';
      }

      function updateButtonVisibility() {
        // No point showing "Read more" if the text already fits within the
        // clamp height with nothing hidden below it.
        const overflowing = body.scrollHeight > body.clientHeight + 2;
        btn.style.display = overflowing || textWrap.classList.contains('expanded') ? '' : 'none';
      }

      syncClampHeight();
      updateButtonVisibility();
      // Re-sync after full load too — once the placeholder is replaced with
      // a real <img>, its async decode/load can change the photo's rendered
      // height after this script's first (pre-image-load) measurement.
      window.addEventListener('load', () => {
        syncClampHeight();
        updateButtonVisibility();
      });
      window.addEventListener('resize', () => {
        syncClampHeight();
        updateButtonVisibility();
      });

      btn.addEventListener('click', () => {
        const expanded = textWrap.classList.toggle('expanded');
        if (expanded) {
          textWrap.style.height = 'auto';
          btn.textContent = 'Read less ↑';
        } else {
          syncClampHeight();
          btn.textContent = 'Read more ↓';
        }
        updateButtonVisibility();
      });
    })();
  </script>

  <footer id="contact">
    <div class="wrap">
      <div class="section-head section-head--tight">
        <h2>Get in touch</h2>
      </div>
      <p class="lead">Open to conversations about learning design, curriculum or training work.</p>
      <div class="contact-row">
        <a href="mailto:dave@example.com">dave@example.com</a>
        <a href="https://www.linkedin.com/in/david-king-learning-designer/" target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
      </div>
      <div class="foot-line">Learning Design Portfolio</div>
    </div>
  </footer>
</BaseLayout>
