---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import CatalogueCard from '../components/CatalogueCard.astro';
import ContactOptions from '../components/ContactOptions.astro';
import { pieces, getPiece } from '../data/pieces.js';
import heroImage from '../assets/images/hero.png';
import profileImage from '../assets/images/profile-pic.jpeg';

const featuredSlugs = ['cumulative-advantage-explorable', 'interactive-alignment-map', 'tacoma-narrows-inquiry-lab'];
const featured = featuredSlugs.map(getPiece);
const rest = pieces.filter((p) => !featuredSlugs.includes(p.slug));
const allPieces = [...featured, ...rest];
---
<BaseLayout
  title="David King — Learning Design Specialist"
  description="Portfolio of interactive learning experiences, assessment design, and educational products by David King, a learning design specialist for higher ed, K-12, and L&D."
  showModalOverlay
>
  <section class="hero" id="top">
    <div class="hero-media">
      <Image src={heroImage} alt="Dave collaborating with a colleague at a laptop in an office" widths={[640, 1200, 1920]} sizes="100vw" loading="eager" fetchpriority="high" />
    </div>
    <div class="wrap">
      <h1 class="headline">Learning Design Specialist</h1>
      <p class="hero-sub">Helping institutions build learning environments that cultivate genuine capability.</p>
      <hr class="hero-accent" />
      <div class="cta-row">
        <a href="#portfolio" class="btn primary">See the work</a>
        <a href="#contact" class="btn ghost">Get in touch</a>
      </div>
    </div>
  </section>

  <section id="portfolio">
    <div class="wrap">
      <div class="section-head">
        <h2>Portfolio</h2>
        <p>Browse the selection of work samples that showcase my areas of expertise.</p>
      </div>

      <div class="filters">
        <div class="filter-group">
          <span class="filter-label">Sector</span>
          <div class="filter-pills" data-filter="sector">
            <button class="fpill active" data-value="all" aria-pressed="true">All</button>
            <button class="fpill" data-value="higher-ed" aria-pressed="false">Higher Ed</button>
            <button class="fpill" data-value="lnd" aria-pressed="false">Learning &amp; Development</button>
            <button class="fpill" data-value="k12" aria-pressed="false">K-12</button>
          </div>
        </div>
        <div class="filter-group">
          <span class="filter-label">Type</span>
          <div class="filter-pills" data-filter="type">
            <button class="fpill active" data-value="all" aria-pressed="true">All</button>
            <button class="fpill" data-value="interactive" aria-pressed="false">Interactive Learning Experience</button>
            <button class="fpill" data-value="assessment">Assessment</button>
            <button class="fpill" data-value="teacher-resources" aria-pressed="false">Teacher Resources</button>
          </div>
        </div>
      </div>

      <div class="piece-grid" id="portfolioGrid">
        {allPieces.map((piece) => <CatalogueCard piece={piece} />)}
      </div>
      <p class="no-results" id="noResults" hidden>No items match those filters.</p>

      <button class="read-more-btn catalogue-trigger" id="catalogueTrigger" type="button" aria-expanded="false" aria-controls="portfolioGrid">See more ↓</button>
    </div>
  </section>

  <script>
    (function () {
      const grid = document.getElementById('portfolioGrid');
      const trigger = document.getElementById('catalogueTrigger');
      const noResults = document.getElementById('noResults');
      if (!grid || !trigger || !noResults) return;

      const cards = Array.from(grid.querySelectorAll('.piece-card'));
      const filterState = { sector: 'all', type: 'all' };
      let expanded = false;

      // Cards beyond the initial 3 stay hidden until expanded; filtering
      // narrows which cards count toward that limit, so the "first row" the
      // trigger reveals below is always the first 3 *matching* cards, not
      // just the first 3 in source order.
      function apply() {
        const matching = cards.filter(
          (card) =>
            (filterState.sector === 'all' || filterState.sector === card.dataset.sector) &&
            (filterState.type === 'all' || filterState.type === card.dataset.type)
        );
        const visibleLimit = expanded ? matching.length : 3;

        cards.forEach((card) => {
          const idx = matching.indexOf(card);
          card.classList.toggle('hide', idx === -1 || idx >= visibleLimit);
        });

        noResults.toggleAttribute('hidden', matching.length !== 0);
        trigger.hidden = matching.length <= 3;
        trigger.setAttribute('aria-expanded', String(expanded));
        trigger.textContent = expanded ? 'See less ↑' : 'See more ↓';
      }

      document.querySelectorAll('.filter-pills').forEach((group) => {
        const dim = group.dataset.filter;
        group.querySelectorAll('.fpill').forEach((btn) => {
          btn.addEventListener('click', () => {
            group.querySelectorAll('.fpill').forEach((b) => {
              b.classList.remove('active');
              b.setAttribute('aria-pressed', 'false');
            });
            btn.classList.add('active');
            btn.setAttribute('aria-pressed', 'true');
            filterState[dim] = btn.dataset.value;
            apply();
          });
        });
      });

      trigger.addEventListener('click', () => {
        expanded = !expanded;
        apply();
      });

      apply();
    })();
  </script>

  <section id="background">
    <div class="wrap">
      <div class="section-head section-head--tight">
        <h2>About me</h2>
      </div>
      <div class="about-grid">
        <div class="about-photo">
          <Image src={profileImage} alt="David King" width={420} height={560} />
        </div>
        <div class="about-text" id="aboutText">
          <div class="about-body" id="aboutBody">
            <p>More than anything, learning requires effort. Unfortunately, that effort is often wasted. Reading without knowing why. Listening to an expert with no bridge between their knowledge and your own. Attempting something hard without the help needed to do it well.</p>
            <p>When I started in education, my mentor was an expert at creating experimental spaces where students could work right at the edge of their abilities: challenged but never lost, guided but never given the answer, encouraged to make discoveries through trial and error. His students were supported to reach their own conclusions and build real skill through their own effort.</p>
            <p>Since moving into learning design, after many years writing curricula and designing courses in my own field, I've been building those same conditions into online learning. That's not always easy. A lot of online learning still asks students to read, watch and click their way through content, rather than giving them something to figure out or work through. And the same thing happens in traditional classrooms. A lecture can be useful, but listening to someone who knows something isn't the same as learning it yourself.</p>
            <p>Technology, and now AI, gives us more ways to change that. We can create environments where learners can make observations, experiment with ideas, have a go, get help and try again. We can give them opportunities to practise and work things out, rather than just read about something. That's what you'll see in this portfolio. It's a collection of work I've built over my career, and each piece reflects part of that approach. Have a look through it. If you see something that might work in your own teaching or course design, get in touch.</p>
          </div>
          <button class="read-more-btn" id="readMoreBtn" type="button">Read more ↓</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    (function () {
      const photo = document.querySelector('.about-photo');
      const textWrap = document.getElementById('aboutText');
      const body = document.getElementById('aboutBody');
      const btn = document.getElementById('readMoreBtn');
      if (!photo || !textWrap || !body || !btn) return;

      // The column height always tracks the photo's rendered height (not a
      // fixed value) so it stays correct across breakpoints and once a real
      // photo replaces the placeholder at a different aspect ratio. It's set
      // on the column itself (not just the clamped text) so the flex layout
      // pins the trigger to that exact bottom edge, flush with the photo.
      function syncClampHeight() {
        if (textWrap.classList.contains('expanded')) return;
        textWrap.style.height = photo.getBoundingClientRect().height + 'px';
      }

      function updateButtonVisibility() {
        // No point showing "Read more" if the text already fits within the
        // clamp height with nothing hidden below it.
        const overflowing = body.scrollHeight > body.clientHeight + 2;
        btn.style.display = overflowing || textWrap.classList.contains('expanded') ? '' : 'none';
      }

      syncClampHeight();
      updateButtonVisibility();
      // Re-sync after full load too — once the placeholder is replaced with
      // a real <img>, its async decode/load can change the photo's rendered
      // height after this script's first (pre-image-load) measurement.
      window.addEventListener('load', () => {
        syncClampHeight();
        updateButtonVisibility();
      });
      window.addEventListener('resize', () => {
        syncClampHeight();
        updateButtonVisibility();
      });

      btn.addEventListener('click', () => {
        const expanded = textWrap.classList.toggle('expanded');
        if (expanded) {
          textWrap.style.height = 'auto';
          btn.textContent = 'Read less ↑';
        } else {
          syncClampHeight();
          btn.textContent = 'Read more ↓';
        }
        updateButtonVisibility();
      });
    })();
  </script>

  <footer id="contact">
    <div class="wrap">
      <div class="section-head section-head--tight">
        <h2>Get in touch</h2>
      </div>
      <p class="lead">Open to conversations about learning design, curriculum or training work.</p>
      <div class="contact-row contact-options">
        <ContactOptions />
      </div>
      <div class="foot-line">Learning Design Portfolio</div>
    </div>
  </footer>
</BaseLayout>
