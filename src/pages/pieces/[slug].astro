---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SubFooter from '../../components/SubFooter.astro';
import NaturalSelection from '../../components/NaturalSelection.jsx';
import SoloRubric from '../../components/SoloRubric.jsx';
import AlignmentMap from '../../components/AlignmentMap.jsx';
import ReactionRateSimulator from '../../components/ReactionRateSimulator.jsx';
import CumulativeAdvantage from '../../components/CumulativeAdvantage.jsx';
import MetacognitionLab from '../../components/metacognition/MetacognitionLab.jsx';
import TacomaNarrowsLab from '../../components/tacoma-narrows/TacomaNarrowsLab.jsx';
import { pieces, getPiece } from '../../data/pieces.js';

export function getStaticPaths() {
  return pieces.map((piece) => ({ params: { slug: piece.slug }, props: { piece } }));
}

const { piece } = Astro.props;

// Tacoma Narrows uses a case-file aesthetic (serif body / mono labels /
// display headings) that the rest of the portfolio doesn't load — only this
// piece's standalone page pulls in the extra font families.
const TACOMA_FONTS_HREF = 'https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,500;1,8..60,400&family=DM+Serif+Display:ital@0;1&display=swap';

// Natural Selection and Cumulative Advantage carry their own tinted palette
// (--paper / --bg inside their own scoped styles) rather than the site's
// white. On mobile, where each asset's own box loses its padding, that tint
// is passed up to BaseLayout so it can fill the whole page background —
// must match the --paper/--bg values set inside each component's own
// <style> block. Every other piece leaves this undefined (plain white).
const MOBILE_BODY_BG = {
  NaturalSelection: '#F4F0E7',
  CumulativeAdvantage: '#F7F8FA',
};
---
{piece.standalonePage ? (
  // This piece's asset is a self-contained full-page tool with its own nav
  // and back link — skip the portfolio's own nav/breadcrumb/framing text and
  // footer entirely so it reads as its own standalone thing to open, not an
  // embed inside a portfolio page.
  <BaseLayout
    title={`${piece.title} — Dave`}
    description={piece.is}
    hideChrome
    extraFontsHref={piece.island === 'TacomaNarrowsLab' ? TACOMA_FONTS_HREF : null}
  >
    <div id="piece-asset">
      {piece.island === 'TacomaNarrowsLab' ? (
        <TacomaNarrowsLab client:only="react" backHref="/#portfolio" />
      ) : piece.island === 'MetacognitionLab' ? (
        <MetacognitionLab client:only="react" backHref="/#portfolio" />
      ) : piece.iframeSrc ? (
        // Static HTML/CSS/JS piece, not a React island — rendered via iframe
        // rather than ported, so it behaves exactly as designed.
        <iframe class="standalone-iframe" src={piece.iframeSrc} title={piece.title} />
      ) : null}
    </div>
  </BaseLayout>
) : (
  <BaseLayout title={`${piece.title} — Dave`} description={piece.is} mobileBodyBg={MOBILE_BODY_BG[piece.island]}>
    <section class="piece-body">
      <div class="wrap">
        <a class="piece-back" href="/#portfolio">← Back to Portfolio</a>

        {/* No tag/title/"what this is" framing here — the visitor lands on
           this page either straight from a shared link or (on mobile, where
           the modal shortcut is skipped) from tapping the card, and in both
           cases the asset itself carries its own heading. Framing text would
           just repeat what the card already said, or duplicate a heading the
           asset renders itself. */}
        <div id="piece-content">
          {piece.island === 'NaturalSelection' ? (
            <div id="piece-asset" class="asset-mount">
              {/* client:only — this component's initial state is Math.random()-driven,
                 so server-rendering it would produce different moths than the client
                 and trigger a hydration mismatch. Nothing here is useful without JS
                 anyway, so skipping SSR for it costs nothing. */}
              <NaturalSelection client:only="react" />
            </div>
          ) : piece.island === 'SoloRubric' ? (
            <div id="piece-asset" class="asset-mount">
              <SoloRubric client:only="react" />
            </div>
          ) : piece.island === 'AlignmentMap' ? (
            <div id="piece-asset" class="asset-mount">
              <AlignmentMap client:only="react" />
            </div>
          ) : piece.island === 'ReactionRateSimulator' ? (
            <div id="piece-asset" class="asset-mount">
              <ReactionRateSimulator client:only="react" />
            </div>
          ) : piece.island === 'CumulativeAdvantage' ? (
            <div id="piece-asset" class="asset-mount">
              <CumulativeAdvantage client:only="react" />
            </div>
          ) : (
            <div id="piece-asset" class="placeholder-box">Preview coming soon.</div>
          )}
        </div>
      </div>
    </section>

    <SubFooter />
  </BaseLayout>
)}

<style>
  .standalone-iframe {
    display: block;
    width: 100%;
    height: 100vh;
    height: 100dvh;
    border: none;
  }
</style>
