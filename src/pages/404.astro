---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Page not found — David King" description="This page doesn't exist. Head back to the portfolio homepage.">
  <section class="piece-body">
    <div class="wrap" style="text-align:center; padding:60px 0;">
      <span class="tag-pill">404</span>
      <h1 style="margin-top:16px;">Page not found</h1>
      <p style="color:var(--text-soft); max-width:440px; margin:14px auto 28px;">
        The page you're looking for doesn't exist or may have moved.
      </p>
      <a href="/" class="btn primary">Back to homepage</a>
    </div>
  </section>
</BaseLayout>
