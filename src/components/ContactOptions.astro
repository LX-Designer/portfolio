---
import { contact } from '../data/contact.js';
---
<a class="contact-option" href={`mailto:${contact.email}`} data-contact-action="email" data-copy-value={contact.email}>
  <span class="contact-icon email" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="3" y="5" width="18" height="14" rx="2.5"/>
      <path d="M3.5 6.5 12 13 20.5 6.5"/>
    </svg>
  </span>
  <span class="contact-text">
    <span class="contact-label">Email</span>
    <span class="contact-value">{contact.email}</span>
  </span>
</a>

<a class="contact-option" href={`https://wa.me/${contact.whatsappNumber}`} target="_blank" rel="noopener noreferrer">
  <span class="contact-icon whatsapp" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 3.5c-4.7 0-8.5 3.4-8.5 7.5 0 2.1 1 4 2.6 5.4L5 20.5l3.8-1.3c1 .3 2.1.5 3.2.5 4.7 0 8.5-3.4 8.5-7.5S16.7 3.5 12 3.5Z"/>
    </svg>
  </span>
  <span class="contact-text">
    <span class="contact-label">WhatsApp</span>
    <span class="contact-value">Start a chat ↗</span>
  </span>
</a>

<a class="contact-option" href={contact.linkedin} target="_blank" rel="noopener noreferrer">
  <span class="contact-icon linkedin" aria-hidden="true">in</span>
  <span class="contact-text">
    <span class="contact-label">LinkedIn</span>
    <span class="contact-value">View profile ↗</span>
  </span>
</a>
