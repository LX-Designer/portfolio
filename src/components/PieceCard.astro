---
const { piece } = Astro.props;
const bodyText = piece.cardBody ?? piece.is;
const showDemonstrates = piece.cardShowDemonstrates ?? true;
const tagsAtBottom = piece.cardTagsPosition === 'bottom';
---
<a class="piece-card" href={`/pieces/${piece.slug}`} data-modal>
  {!tagsAtBottom && <span class="tag-pill">{piece.tag}</span>}
  <h3>{piece.title}</h3>
  <p class="is">{bodyText}</p>
  {showDemonstrates && <p class="demo"><b>Demonstrates:</b> {piece.demonstrates}</p>}
  {tagsAtBottom && (
    <div class="pill-row-bottom">
      <span class="tag-pill">{piece.tag}</span>
    </div>
  )}
</a>
