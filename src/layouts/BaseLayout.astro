---
import '../styles/global.css';
import ContactOptions from '../components/ContactOptions.astro';

const { title, description = '', showModalOverlay = false } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="nav">
    <div class="wrap">
      <a class="wordmark" href="/">David King</a>
      <ul id="navlinks">
        <li><a href="/#portfolio">Portfolio</a></li>
        <li><a href="/#background">About</a></li>
        <li><a href="/#contact" id="contactLink">Contact</a></li>
      </ul>
      <button class="nav-toggle" id="navToggle" aria-label="Toggle menu">≡</button>
    </div>
  </header>

  <slot />

  {showModalOverlay && (
    <div class="modal-overlay" id="modal-overlay">
      <div class="modal-panel"></div>
    </div>
  )}

  <div class="modal-overlay" id="contact-modal-overlay">
    <div class="modal-panel contact-modal-panel">
      <button class="modal-close" id="contactModalClose" aria-label="Close">✕</button>
      <h3>Get in touch</h3>
      <div class="contact-options">
        <ContactOptions />
      </div>
    </div>
  </div>

  <script>
    // Mobile nav toggle — present on every page
    document.addEventListener('DOMContentLoaded', () => {
      const toggle = document.getElementById('navToggle');
      const links = document.getElementById('navlinks');
      if (toggle && links) {
        toggle.addEventListener('click', () => links.classList.toggle('open'));
        links.querySelectorAll('a').forEach((a) =>
          a.addEventListener('click', () => links.classList.remove('open'))
        );
      }

      // Contact picker — present on every page via BaseLayout, unlike the
      // piece-preview modal below which only exists on pages that opt in.
      const contactTrigger = document.getElementById('contactLink');
      const contactOverlay = document.getElementById('contact-modal-overlay');
      const contactClose = document.getElementById('contactModalClose');
      if (contactTrigger && contactOverlay) {
        const openContact = (e) => {
          e.preventDefault();
          contactOverlay.classList.add('open');
          document.body.style.overflow = 'hidden';
        };
        const closeContact = () => {
          contactOverlay.classList.remove('open');
          document.body.style.overflow = '';
        };
        contactTrigger.addEventListener('click', openContact);
        contactClose.addEventListener('click', closeContact);
        contactOverlay.addEventListener('click', (e) => {
          if (e.target === contactOverlay) closeContact();
        });
        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && contactOverlay.classList.contains('open')) closeContact();
        });
      }

      // Email copy-to-clipboard — the link's real href stays a working
      // mailto: fallback (no-JS, or if the Clipboard API/permission fails),
      // so this only intercepts the click once a copy actually succeeds.
      document.querySelectorAll('[data-contact-action="email"]').forEach((el) => {
        const valueEl = el.querySelector('.contact-value');
        const defaultText = valueEl.textContent;
        let resetTimer;
        el.addEventListener('click', (e) => {
          if (!navigator.clipboard) return;
          e.preventDefault();
          navigator.clipboard
            .writeText(el.dataset.copyValue)
            .then(() => {
              clearTimeout(resetTimer);
              el.classList.add('copied');
              valueEl.textContent = 'Copied ✓';
              resetTimer = setTimeout(() => {
                el.classList.remove('copied');
                valueEl.textContent = defaultText;
              }, 1800);
            })
            .catch(() => {
              window.location.href = el.getAttribute('href');
            });
        });
      });

      // Modal interception — only runs on category pages, which include
      // a #modal-overlay element and piece cards with [data-modal] hrefs.
      const overlay = document.getElementById('modal-overlay');
      if (!overlay) return;

      const panel = overlay.querySelector('.modal-panel');
      // Captured once, before any pushState touches the address bar. Resolving
      // against window.location instead (which pushState mutates) makes every
      // relative href after the first open/close cycle resolve to the wrong path.
      const categoryUrl = window.location.href;

      async function openModal(href, push) {
        const url = new URL(href, categoryUrl).href;
        try {
          const res = await fetch(url);
          const html = await res.text();
          const doc = new DOMParser().parseFromString(html, 'text/html');
          // The modal shows only the asset itself, not the card's framing text
          // (tag, title, "what this is") repeated — the visitor already saw that
          // on the card they just clicked.
          const content = doc.querySelector('#piece-asset');
          if (!content) { window.location.href = url; return; }
          panel.innerHTML =
            '<button class="modal-close" id="modalClose" aria-label="Close">✕</button>' +
            content.outerHTML;
          // innerHTML never executes <script> tags (classic or module, including
          // Astro's own island-hydration scripts) — re-create each one so that
          // interactive pieces work inside the modal too, not just static copy.
          panel.querySelectorAll('script').forEach((old) => {
            const fresh = document.createElement('script');
            for (const attr of old.attributes) fresh.setAttribute(attr.name, attr.value);
            fresh.textContent = old.textContent;
            old.replaceWith(fresh);
          });
          overlay.classList.add('open');
          document.body.style.overflow = 'hidden';
          document.getElementById('modalClose').addEventListener('click', closeModal);
          if (push) history.pushState({ modal: url }, '', url);
        } catch (err) {
          // If fetch fails, fall back to a normal page load rather than leaving a dead click.
          window.location.href = url;
        }
      }

      function closeModal(push) {
        overlay.classList.remove('open');
        document.body.style.overflow = '';
        if (push !== false) history.pushState({}, '', categoryUrl);
      }

      // Below this width, skip the modal shortcut entirely and let the tap
      // navigate to the piece's real page. A modal floating over content is a
      // desktop-web convention; full-page navigation on tap is how mobile
      // browsing already works, and it's what a shared link lands on anyway —
      // this just makes browsing the grid behave the same way. Checked fresh
      // on every click (not cached) so a resize/rotation is respected.
      const isMobile = () => window.matchMedia('(max-width: 640px)').matches;

      document.querySelectorAll('[data-modal]').forEach((link) => {
        link.addEventListener('click', (e) => {
          if (isMobile()) return;
          e.preventDefault();
          openModal(link.getAttribute('href'), true);
        });
      });

      overlay.addEventListener('click', (e) => {
        if (e.target === overlay) closeModal();
      });

      window.addEventListener('popstate', (e) => {
        if (e.state && e.state.modal) {
          openModal(e.state.modal, false);
        } else {
          closeModal(false);
        }
      });
    });
  </script>
</body>
</html>
